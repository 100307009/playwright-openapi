# Copy this file to .env and adjust as needed.
# .env is gitignored - never commit real credentials.
#
# This suite targets a single API spec/backend - every fixture/test reads its config through the
# API_* variables below.

# ---------------------------------------------------------------------------
# API - points at the public Swagger Petstore OpenAPI 3 demo.
# ---------------------------------------------------------------------------
API_SPEC_URL=https://petstore3.swagger.io/api/v3/openapi.json
API_BASE_URL=https://petstore3.swagger.io/api/v3

# Auth credentials used by contract/flow/UI tests via the shared `credentials` fixture.
# "special-key" is the documented default api_key for this public demo.
API_VALID_API_KEY=special-key
API_INVALID_API_KEY=not-a-real-key

API_VALID_USERNAME=user1
API_VALID_PASSWORD=password1
API_INVALID_USERNAME=nonexistent_user
API_INVALID_PASSWORD=totally-wrong-password

# Known seed data on the public demo / IDs safe to use for negative tests.
API_EXISTING_PET_ID=1
API_NONEXISTENT_PET_ID=999999999

# ---------------------------------------------------------------------------
# UI
# ---------------------------------------------------------------------------
# The Petstore demo has no product UI of its own; the Swagger UI page hosted alongside the API is
# used as a real UI that genuinely depends on the API (auth + "Try it out" actions), standing in
# for a real frontend under test.
UI_BASE_URL=https://petstore3.swagger.io/

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Where the fetched OpenAPI spec is cached for the duration of a test run.
SPEC_CACHE_DIR=.cache/specs
