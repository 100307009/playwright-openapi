# Copy this file to .env and adjust as needed.
# .env is gitignored - never commit real credentials.
#
# This project is version-aware: every fixture/test reads its config through
# API_<VERSION>_* variables, selected by the Playwright "project" it runs under
# (see playwright.config.ts). Add a new version by filling in its own block
# below and adding a matching project - no test code needs to change.

# ---------------------------------------------------------------------------
# v2 - LIVE. Points at the public Swagger Petstore OpenAPI 3 demo.
# ---------------------------------------------------------------------------
API_V2_SPEC_URL=https://petstore3.swagger.io/api/v3/openapi.json
API_V2_BASE_URL=https://petstore3.swagger.io/api/v3

# Auth credentials used by contract/flow/UI tests via the shared `credentials` fixture.
# "special-key" is the documented default api_key for this public demo.
API_V2_VALID_API_KEY=special-key
API_V2_INVALID_API_KEY=not-a-real-key

API_V2_VALID_USERNAME=user1
API_V2_VALID_PASSWORD=password1
API_V2_INVALID_USERNAME=nonexistent_user
API_V2_INVALID_PASSWORD=totally-wrong-password

# Known seed data on the public demo / IDs safe to use for negative tests.
API_V2_EXISTING_PET_ID=1
API_V2_NONEXISTENT_PET_ID=999999999

# ---------------------------------------------------------------------------
# v1 - NOT WIRED UP YET. Fill these in (and enable the *-v1 projects in
# playwright.config.ts) once a real v1 spec/backend is available. Until then,
# v1 projects are defined but skipped - see tests/contract/*.contract.spec.ts.
# ---------------------------------------------------------------------------
API_V1_SPEC_URL=
API_V1_BASE_URL=
API_V1_VALID_API_KEY=
API_V1_INVALID_API_KEY=
API_V1_VALID_USERNAME=
API_V1_VALID_PASSWORD=
API_V1_INVALID_USERNAME=
API_V1_INVALID_PASSWORD=
API_V1_EXISTING_PET_ID=
API_V1_NONEXISTENT_PET_ID=

# ---------------------------------------------------------------------------
# UI
# ---------------------------------------------------------------------------
# The Petstore demo has no product UI of its own; the Swagger UI page hosted
# alongside the v2 API is used as a real UI that genuinely depends on the API
# (auth + "Try it out" actions), standing in for a real frontend under test.
UI_V2_BASE_URL=https://petstore3.swagger.io/

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Where fetched OpenAPI specs are cached for the duration of a test run.
SPEC_CACHE_DIR=.cache/specs
