{
  "name": "testqa",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright-based API contract, flow, and UI test suite (with allure reporting and OpenAPI schema validation)",
  "scripts": {
    "test": "playwright test; status=$?; npm run allure:generate --silent; exit $status",
    "test:contract": "playwright test --project=contract",
    "test:flow": "playwright test --project=flow",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --debug",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run types:generate --silent",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "types:generate": "tsx scripts/generateTypes.ts",
    "pretest": "npm run types:generate --silent"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "allure-commandline": "^2.30.0",
    "allure-js-commons": "3.11.1",
    "allure-playwright": "3.11.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.7.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-fetch": "3.11.1",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0"
  }
}
